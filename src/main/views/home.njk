{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% extends "template.njk" %}

<!-- You may want to make further use of these components: https://design-system.service.gov.uk/components/
but ultimately it is up to you -->

{% block content %}
  <h1 class="govuk-heading-xl">Case List
  <span class="govuk-caption-l">Create, view, update, and delete case tasks</span>
  </h1>
  


  {{ govukButton({
    text: "Add New Case",
    href: "/cases/new",
    isStartButton: true
  }) }}

  <!-- The freedom is yours. You can design the solution however you like, however there is a starting point provided
  to ensure you have both services running. You may want to make use of the Gov UK Components:
  https://design-system.service.gov.uk/components/ to add tabs and so forth :) -->

  <div class="case-list" role="region" aria-label="Cases" tabindex="0">
    {% for item in example %}
      {{ govukSummaryList({
        rows: [
          {
            key: {
              text: "ID"
            },
            value: {
              text: item.id
            }
          },
          {
            key: {
              text: "Title"
            },
            value: {
              text: item.title
            }
          },
          {
            key: {
              text: "Description"
            },
            value: {
              text: item.description
            }
          },
          {
            key: {
              text: "Status"
            },
            value: {
              text: item.status
            }
          },
          {
            key: {
             text: "Due Date"
            },
            value: {
             text: item.dueDate
            }
          }
        ]
      }) }}
      <form method="post" action="/cases/{{ item.id }}/delete">
        <div class="govuk-button-group">
          {{ govukButton({
            text: "Edit",
            href: "/cases/" + item.id + "/edit"
          }) }}
          {{ govukButton({
            text: "Delete",
            classes: "govuk-button--warning",
            type: "submit"
          }) }}
        </div>
      </form>
    {% endfor %}
  </div>

{% endblock %}
